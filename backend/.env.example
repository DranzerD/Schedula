# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/schedula

# JWT Secret Key (use a strong, random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration Time
JWT_EXPIRE=7d

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# ---------------------------------------------------------------
# Groq AI (optional — every AI feature falls back to deterministic
# rules when the key is missing or Groq is unreachable)
# Get a key at https://console.groq.com/keys
# ---------------------------------------------------------------
GROQ_API_KEY=
# Quality model (task parsing, insights)
GROQ_MODEL=openai/gpt-oss-120b
# Cheap/low-latency model (explanation narratives)
GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_MS=15000
# GROQ_MAX_RETRIES=2
